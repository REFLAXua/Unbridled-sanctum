  m_Script: {fileID: 11500000, guid: b6d7d8818b065a048a22fcf1221d9a15, type: 3}
  m_Name: event_spring
  m_EditorClassIdentifier: 
  sequenceId: event_spring
  enemyType: 0
  requiredCombatPhase: 0
  lines:
  - speaker: 2
    speakerName: Mystic Spring
    text: You discover a secluded cavern grotto where warm, translucent azure liquid
      gently bubbles into a crystalline basin.
    playerExpression: Normal
    enemyEmotion: smile
  - speaker: 1
    speakerName: Slime Maiden
    text: Hehe! Hello traveler! Looking for a quick dip? The minerals here soothe
      weary muscles and melt away fatigue!
    playerExpression: Smile
    enemyEmotion: smile
  - speaker: 0
    speakerName: You
    text: It looks peaceful. A momentary respite in these dark depths is a rare blessing.
    playerExpression: Smile
    enemyEmotion: smile
  - speaker: 1
    speakerName: Slime Maiden
    text: Go on, splash some on your face! It tingles with rejuvenating mana! Just
      don't drink too much, or you'll get bouncy!
    playerExpression: Delighted
    enemyEmotion: grin
  - speaker: 2
    speakerName: Mystic Spring
    text: You bathed your face and hands in the warm waters, feeling vitality seep
      back into your body (+15 HP, clothes refreshed).
    playerExpression: Delighted
    enemyEmotion: smile
