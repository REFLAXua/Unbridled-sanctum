  m_Script: {fileID: 11500000, guid: b6d7d8818b065a048a22fcf1221d9a15, type: 3}
  m_Name: succub_vic_hp_0
  m_EditorClassIdentifier: 
  sequenceId: succub_vic_hp_0
  enemyType: 1
  requiredCombatPhase: 0
  lines:
  - speaker: 1
    speakerName: Succubus
    text: Tch! Such barbaric roughness! Do mortals know no romance beyond blunt iron?
    playerExpression: Angry
    enemyEmotion: annoyed
  - speaker: 0
    speakerName: You
    text: Your cheap charms don't work on me, demon. Step aside or face true steel.
    playerExpression: Smug
    enemyEmotion: annoyed
  - speaker: 1
    speakerName: Succubus
    text: Hmph! Such an unrefined brute. I shall retreat to my velvet boudoir to
      nurse my bruises.
    playerExpression: Normal
    enemyEmotion: smile
