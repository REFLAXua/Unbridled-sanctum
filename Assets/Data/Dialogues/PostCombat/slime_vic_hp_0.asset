  m_Script: {fileID: 11500000, guid: b6d7d8818b065a048a22fcf1221d9a15, type: 3}
  m_Name: slime_vic_hp_0
  m_EditorClassIdentifier: 
  sequenceId: slime_vic_hp_0
  enemyType: 0
  requiredCombatPhase: 0
  lines:
  - speaker: 1
    speakerName: Slime Girl
    text: Ow, ow, ow! How can your strikes hurt so much when my body is made of gelatin?!
    playerExpression: Normal
    enemyEmotion: annoyed
  - speaker: 0
    speakerName: You
    text: Gelatin or not, you were blocking my passage. Had enough?
    playerExpression: Smug
    enemyEmotion: annoyed
  - speaker: 1
    speakerName: Slime Girl
    text: Eep! Put that blade away! I'm seeping into the stone cracks... you won't
      catch me!
    playerExpression: Normal
    enemyEmotion: suprised
  - speaker: 2
    speakerName: Narrator
    text: The Slime Girl liquefied her lower half and slipped swiftly into a narrow
      subterranean fissure, leaving behind scattered loot.
    playerExpression: Smile
    enemyEmotion: suprised
